<odoo noupdate="1">
    <!-- Off by default: the channels are read on request (Read Now, or the agent). An organisation
         that wants the candidates to arrive by themselves activates it in Settings > Scheduled Actions. -->
    <record id="ir_cron_memory_source_collect" model="ir.cron">
        <field name="name">Memory: read the overdue external source channels</field>
        <field name="model_id" ref="model_memory_source_channel"/>
        <field name="state">code</field>
        <field name="code">model._cron_collect()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
