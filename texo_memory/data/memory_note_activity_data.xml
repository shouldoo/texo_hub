<!-- Only the activities every organisation has: a sector adds its own through the seed of its pack. -->
<odoo noupdate="1">
    <record id="activity_analysis" model="memory.note.activity">
        <field name="name">Analysis</field>
        <field name="code">analysis</field>
        <field name="sequence">10</field>
        <field name="description">Studying a request, a process or a document before deciding what to do.</field>
    </record>
    <record id="activity_communication" model="memory.note.activity">
        <field name="name">Communication</field>
        <field name="code">communication</field>
        <field name="sequence">20</field>
        <field name="description">Texts that leave the organisation: proposals, answers, messages, documentation.</field>
    </record>
</odoo>
