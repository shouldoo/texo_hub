<odoo>
    <data noupdate="1">
        <record id="ir_cron_memory_housekeeping" model="ir.cron">
            <field name="name">Memory: weekly housekeeping</field>
            <field name="model_id" ref="model_memory_lesson"/>
            <field name="state">code</field>
            <field name="code">model._cron_housekeeping()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=7)).strftime('%Y-%m-%d 06:00:00')"/>
        </record>
    </data>
</odoo>
