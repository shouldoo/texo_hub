<odoo>
    <!-- The review of the memory as a dashboard, one card per area: the main queue as a big button, the
         other queues of the area as lines. A module that adds an area adds its lines with an xpath on
         div[@name='queues'] (texo_sources, texo_vector). -->
    <record id="view_memory_review_area_kanban" model="ir.ui.view">
        <field name="name">memory.review.area.kanban</field>
        <field name="model">memory.review.area</field>
        <field name="arch" type="xml">
            <kanban create="0" records_draggable="0" group_create="0" can_open="0" class="o_memory_review_kanban">
                <field name="code"/>
                <field name="main_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column h-100">
                            <field name="name" class="fw-bold fs-4"/>
                            <field name="description" class="text-muted small"/>
                            <div class="mt-3">
                                <button name="action_open_main" type="object" class="btn btn-primary"
                                        invisible="not main_count">
                                    <field name="main_count"/>
                                    <field name="main_title" class="ms-1"/>
                                </button>
                                <button name="action_open_main" type="object" class="btn btn-secondary"
                                        invisible="main_count">
                                    <field name="main_count"/>
                                    <field name="main_title" class="ms-1"/>
                                </button>
                            </div>
                            <div name="queues" class="mt-3">
                                <t t-if="record.code.raw_value == 'knowledge'">
                                    <div class="d-flex justify-content-between">
                                        <a name="action_open_queue" type="object" context="{'queue': 'draft_rules'}">Draft Rules</a>
                                        <field name="draft_rules"/>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <a name="action_open_queue" type="object" context="{'queue': 'changed_documents'}">Changed Documents</a>
                                        <field name="changed_documents"/>
                                    </div>
                                </t>
                                <t t-if="record.code.raw_value == 'lessons'">
                                    <div class="d-flex justify-content-between">
                                        <a name="action_open_queue" type="object" context="{'queue': 'duplicate_lessons'}">Near-duplicate Lessons</a>
                                        <field name="duplicate_lessons"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_memory_review_area" model="ir.actions.act_window">
        <field name="name">To Review</field>
        <field name="res_model">memory.review.area</field>
        <field name="view_mode">kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to review</p>
            <p>The weekly review of the memory: each card is an area, its button opens what waits in it.</p>
        </field>
    </record>
</odoo>
