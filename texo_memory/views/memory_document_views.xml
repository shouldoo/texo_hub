<odoo>
    <!-- The documents of the memory are attachments: these views show them as documents. -->
    <record id="view_memory_document_list" model="ir.ui.view">
        <field name="name">ir.attachment.memory.document.list</field>
        <field name="model">ir.attachment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="type"/>
                <field name="res_name" string="Belongs To"/>
                <field name="res_model" optional="hide"/>
                <field name="texo_read_on"/>
                <field name="texo_changed_on" optional="show"/>
                <field name="texo_keep_text" optional="hide"/>
                <field name="create_uid" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_memory_document_form" model="ir.ui.view">
        <field name="name">ir.attachment.memory.document.form</field>
        <field name="model">ir.attachment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <h1><field name="name" placeholder="Title"/></h1>
                    <group>
                        <group>
                            <field name="type" readonly="1"/>
                            <field name="raw" filename="name" invisible="type == 'url'" readonly="1"/>
                            <field name="url" widget="url" invisible="type == 'binary'"/>
                            <field name="res_name" string="Belongs To" readonly="1"/>
                            <field name="res_model" readonly="1" groups="base.group_no_one"/>
                            <field name="res_id" readonly="1" groups="base.group_no_one"/>
                        </group>
                        <group>
                            <field name="texo_read_on"/>
                            <field name="texo_fingerprint" readonly="1"/>
                            <field name="texo_changed_on" invisible="not texo_changed_on" readonly="1"/>
                            <field name="texo_keywords"/>
                            <field name="texo_keep_text"/>
                            <field name="texo_text_ids" widget="many2many_tags" readonly="1"/>
                            <field name="texo_created" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What the document contains, in a few lines"/>
                    <notebook>
                        <page string="Text" name="text">
                            <div class="alert alert-info" role="status" invisible="texo_keep_text">
                                A sensitive document: the memory keeps no text of it. Open the original.
                            </div>
                            <div class="text-muted" invisible="not texo_keep_text or texo_text">
                                No converted text yet: the agent converts the original when it reads it.
                            </div>
                            <field name="texo_text" nolabel="1" readonly="1" class="font-monospace"
                                   invisible="not texo_text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_memory_document_search" model="ir.ui.view">
        <field name="name">ir.attachment.memory.document.search</field>
        <field name="model">ir.attachment</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="res_name" string="Belongs To"/>
                <field name="texo_keywords"/>
                <filter name="changed" string="Changed" domain="[('texo_changed_on', '!=', False)]"
                        help="The original changed after it was read: the notes taken from it are to check"/>
                <filter name="sensitive" string="Sensitive" domain="[('texo_keep_text', '=', False)]"/>
                <filter name="mine" string="Mine" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="read_on" string="Read On" date="texo_read_on"/>
                <separator/>
                <filter name="group_model" string="Record Type" context="{'group_by': 'res_model'}"/>            </search>
        </field>
    </record>

    <record id="action_memory_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('texo_document', '=', True)]</field>
        <field name="context">{'default_texo_document': True}</field>
        <field name="search_view_id" ref="view_memory_document_search"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('view_memory_document_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('view_memory_document_form')})]"/>
    </record>
</odoo>
