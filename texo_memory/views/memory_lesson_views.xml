<odoo>
    <record id="view_memory_lesson_list" model="ir.ui.view">
        <field name="name">memory.lesson.list</field>
        <field name="model">memory.lesson</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            groups="texo.group_texo_lead"/>
                    <button name="action_archive_lesson" type="object" string="Archive"
                            groups="texo.group_texo_lead"/>
                </header>
                <field name="name"/>
                <field name="finding" optional="hide"/>
                <field name="keywords" optional="hide"/>
                <field name="kind"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="applies_to"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="verified"/>
                <field name="expires"/>
                <field name="merged_count"/>
                <field name="origin" optional="hide"/>
                <field name="write_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_memory_lesson_form" model="ir.ui.view">
        <field name="name">memory.lesson.form</field>
        <field name="model">memory.lesson</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            invisible="state != 'draft'" groups="texo.group_texo_lead"/>
                    <button name="action_archive_lesson" type="object" string="Archive"
                            invisible="state == 'archived'" groups="texo.group_texo_lead"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,superseded"/>
                </header>
                <sheet>
                    <h1><field name="name" placeholder="Title"/></h1>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="lesson_activity_ids" widget="many2many_tags"/>
                            <field name="keywords"/>
                            <field name="applies_to"/>
                            <field name="origin"/>
                            <field name="generated_by" invisible="origin != 'agent'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="verified"/>
                            <field name="expires"/>
                            <field name="merged_count"/>
                            <field name="supersedes_id"/>
                            <field name="superseded_by_id"/>
                        </group>
                    </group>
                    <group string="Finding">
                        <field name="finding" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Solution">
                        <field name="solution" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_memory_lesson_search" model="ir.ui.view">
        <field name="name">memory.lesson.search</field>
        <field name="model">memory.lesson</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="finding"/>
                <field name="solution"/>
                <field name="applies_to"/>
                <field name="keywords"/>
                <field name="tag_ids"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="superseded" string="Superseded" domain="[('state', '=', 'superseded')]"/>
                <separator/>
                <filter name="expired" string="Expired" domain="[('expires', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="expiring" string="Expiring in 30 Days"
                        domain="[('expires', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('expires', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="by_agent" string="Written by an Agent" domain="[('origin', '=', 'agent')]"/>
                <filter name="by_person" string="Written by a Person" domain="[('origin', '=', 'person')]"/>
                <filter name="mine" string="Mine" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="modified" string="Modified" date="write_date"/>
                <separator/>
                <filter name="group_tag" string="Tag" context="{'group_by': 'tag_ids'}"/>
                <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_origin" string="Written By" context="{'group_by': 'origin'}"/>
            </search>
        </field>
    </record>

    <record id="action_memory_lesson" model="ir.actions.act_window">
        <field name="name">Lessons</field>
        <field name="res_model">memory.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
