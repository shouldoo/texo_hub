<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="form_res_users_key_description_texo" model="ir.ui.view">
        <field name="name">res.users.apikeys.description.form.texo</field>
        <field name="model">res.users.apikeys.description</field>
        <field name="inherit_id" ref="base.form_res_users_key_description"/>
        <field name="arch" type="xml">
            <field name="duration" position="after">
                <field name="texo_read_only" invisible="scope != 'texo'"/>
            </field>
        </field>
    </record>

    <record id="view_res_users_apikeys_texo_list" model="ir.ui.view">
        <field name="name">res.users.apikeys.list.texo</field>
        <field name="model">res.users.apikeys</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="user_id"/>
                <field name="name"/>
                <field name="create_date"/>
                <field name="expiration_date"/>
                <field name="texo_read_only"/>
                <field name="user_texo_last_seen"/>
            </list>
        </field>
    </record>

    <record id="view_res_users_apikeys_texo_search" model="ir.ui.view">
        <field name="name">res.users.apikeys.search.texo</field>
        <field name="model">res.users.apikeys</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="name"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_res_users_apikeys_texo" model="ir.actions.act_window">
        <field name="name">Texo Tokens</field>
        <field name="res_model">res.users.apikeys</field>
        <field name="view_mode">list</field>
        <field name="domain">[('scope', '=', 'texo')]</field>
        <field name="view_id" ref="view_res_users_apikeys_texo_list"/>
        <field name="search_view_id" ref="view_res_users_apikeys_texo_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Texo token yet</p>
            <p>Users create their token from My Preferences, Security, New API Key, scope Texo.</p>
        </field>
    </record>

    <menuitem
        id="menu_texo_tokens"
        name="Texo Tokens"
        parent="base.menu_users"
        action="action_res_users_apikeys_texo"
        groups="texo.group_texo_admin"
        sequence="90"/>
</odoo>
